# API keys. QIANWEN and DEEPSEEK are also accepted as legacy key names.
QIANWEN_API_KEY=your-qianwen-key
DEEPSEEK_API_KEY=your-deepseek-key
OPENAI_API_KEY=your-openai-key

# OpenAI-compatible model names and endpoints.
QIANWEN_MODEL=openai/qwen-plus
QIANWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_MODEL=openai/deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional runtime settings.
DEBATE_DB_PATH=data/debates.sqlite3
CREWAI_DATA_PATH=data/crewai
DEBATE_REQUEST_TIMEOUT=60
DEBATE_MAX_OUTPUT_CHARS=12000

